    <!-- Ancestor MIPs driven by flags (one bind per nodeset — engine bind cardinality 0..1) -->
    <xf:bind nodeset="instance('data')/d:section"
             relevant="instance('data')/d:flags/d:section-open = 'true'"
             readonly="instance('data')/d:flags/d:can-edit != 'true'"/>
    <xf:bind nodeset="instance('data')/d:section/d:group/d:item/d:value"
             type="xs:string"/>
  </xf:model>

  <div id="mip-perf-root">
    <div id="toolbar">
      <span id="section-open-output">
        <xf:output ref="instance('data')/d:flags/d:section-open" class="section-open-out"/>
      </span>
      <span id="can-edit-output">
        <xf:output ref="instance('data')/d:flags/d:can-edit" class="can-edit-out"/>
      </span>
      <xf:trigger class="hide-section">
        <xf:label>Hide</xf:label>
        <xf:action ev:event="DOMActivate">
          <xf:setvalue ref="instance('data')/d:flags/d:section-open">false</xf:setvalue>
        </xf:action>
      </xf:trigger>
      <xf:trigger class="show-section">
        <xf:label>Show</xf:label>
        <xf:action ev:event="DOMActivate">
          <xf:setvalue ref="instance('data')/d:flags/d:section-open">true</xf:setvalue>
        </xf:action>
      </xf:trigger>
      <xf:trigger class="enable-edit">
        <xf:label>Unlock</xf:label>
        <xf:action ev:event="DOMActivate">
          <xf:setvalue ref="instance('data')/d:flags/d:can-edit">true</xf:setvalue>
        </xf:action>
      </xf:trigger>
      <xf:trigger class="disable-edit">
        <xf:label>Lock</xf:label>
        <xf:action ev:event="DOMActivate">
          <xf:setvalue ref="instance('data')/d:flags/d:can-edit">false</xf:setvalue>
        </xf:action>
      </xf:trigger>
      <!-- Bound trigger: inherits section relevant + readonly MIPs via ref on a leaf -->
      <xf:trigger class="leaf-act" ref="instance('data')/d:section/d:group[@n='1']/d:item[@n='1']/d:value">
        <xf:label>Act</xf:label>
        <xf:action ev:event="DOMActivate">
          <xf:setvalue ref="instance('data')/d:section/d:group[@n='1']/d:item[@n='1']/d:value">acted</xf:setvalue>
        </xf:action>
      </xf:trigger>
    </div>

    <div id="tree">
      <xf:repeat id="group-repeat" nodeset="instance('data')/d:section/d:group">
        <div class="group-block">
          <xf:repeat id="item-repeat" nodeset="d:item">
            <div class="item-row">
              <span class="item-label"><xf:output ref="d:label"/></span>
              <xf:input ref="d:value" class="item-value">
                <xf:label>v</xf:label>
              </xf:input>
            </div>
          </xf:repeat>
        </div>
      </xf:repeat>
    </div>
  </div>
</xf:xform>
